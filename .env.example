# ========================================================
# MyPocket - Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials:
# cp .env.example .env.local
# ========================================================

# Supabase Project API URL (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (anon public key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
